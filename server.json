{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.nikships/gemdex",
  "title": "Gemdex",
  "description": "Persistent memory layer for AI coding agents: save, recall, update with on-device MLX embeddings and LanceDB",
  "repository": {
    "url": "https://github.com/nikships/gemdex",
    "source": "github",
    "id": "1249655672"
  },
  "websiteUrl": "https://github.com/nikships/gemdex",
  "version": "1.0.47",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "gemdex-mcp",
      "version": "1.0.47",
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-y",
          "valueHint": "auto-confirm install"
        },
        {
          "type": "positional",
          "value": "gemdex-mcp@1.0.47",
          "valueHint": "package spec"
        }
      ],
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Directory for the embedded LanceDB store",
          "isRequired": false,
          "format": "filepath",
          "default": "~/.gemdex/lance",
          "name": "LANCEDB_PATH"
        },
        {
          "description": "Re-rank recall results by recorded worked/failed/stale outcomes",
          "isRequired": false,
          "format": "boolean",
          "default": "false",
          "name": "GEMDEX_TRUST_RANKING"
        }
      ]
    }
  ]
}
